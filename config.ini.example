[poe]
# Display hardware: 'poe' (SSD1306 128x32 I2C) or 'waveshare-1.3' (SH1106 128x64 SPI)
display = poe
# Fan hardware: 'poe' (Waveshare PoE HAT I2C 0x20) or 'none' (fan hardware disabled / passive)
fan = poe
# Fan ON at or above this temperature (C).
fan_on_temp = 43
# Fan OFF strictly below this temperature (C).
fan_off_temp = 41
# Seconds between updates. Restart the service after editing.
interval = 1
# Seconds each page stays on screen before rotating.
page_interval = 3
# OLED contrast (1-255).
contrast = 50
# Shift the rendered image by one pixel as pages rotate.
pixel_shift = true
# Turn off the display after this many seconds. 0 keeps it always on.
screen_timeout = 0
